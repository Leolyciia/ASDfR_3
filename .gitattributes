# Auto-detect text files and ensure they use LF endings
* text=auto eol=lf

# Explicitly declare common text file types to always use LF
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.launch text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf
CMakeLists.txt text eol=lf
package.xml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

